MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=moderation
MYSQL_USER=moderation
MYSQL_PASSWORD=moderation123
DASHSCOPE_API_KEY=replace-with-real-key
MODEL_SERVICE_ACTIVE_PROFILE=
# L2 文本权重当前只有未经风控微调的分类头，默认关闭 ONNX、保留关键词 fallback。
MODEL_L2_TEXT_ENABLED=false
MODEL_L2_IMAGE_ENABLED=true
MODEL_L2_IMAGE_MODEL_PATH=/models/resnet50_finetune_onnx
MODEL_L3_PROVIDER=failover
MODEL_L3_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_L3_BAILIAN_MODEL=qwen3.8-flash
MODEL_L3_BAILIAN_TIMEOUT_MS=18000
# Legacy variable names retained for compatibility; any OpenAI-compatible local endpoint works.
MODEL_L3_VLLM_BASE_URL=http://127.0.0.1:11434/v1
MODEL_L3_VLLM_DOCKER_BASE_URL=http://host.docker.internal:11434/v1
MODEL_L3_VLLM_MODEL=qwen3.5:0.8b
MODEL_L3_VLLM_REASONING_EFFORT=none
MODEL_L3_VLLM_TIMEOUT_MS=7000
MODEL_SERVICE_INFER_TIMEOUT_MS=27000
MODEL_SERVICE_L3_CIRCUIT_FAILURE_THRESHOLD=5
MODEL_SERVICE_L3_CIRCUIT_OPEN_MS=15000
# 预算阶梯（必须自洽，任一层改动都要同步核对其上下的层）：
#   provider 18s(百炼) + 7s(本地) + 2s 调度余量 = MODEL_SERVICE_INFER_TIMEOUT_MS 27s
#   < 同步/异步 model-service 调用预算 30s
#   < Gateway 响应预算 32s / 异步消费侧 block 预算 35s
#   < PROCESSING 租约 90s
MODERATION_MODEL_SERVICE_TIMEOUT_MS=30000
MODERATION_MODEL_SERVICE_ASYNC_TIMEOUT_MS=30000
MODERATION_ASYNC_ENQUEUE_TIMEOUT_MS=5000
MODERATION_ASYNC_PROCESS_TIMEOUT_MS=35000
MODERATION_ASYNC_MAX_RETRIES=2
MODERATION_ASYNC_RETRY_BACKOFF_MS=1000
MODERATION_ASYNC_PROCESSING_LEASE_MS=90000
GATEWAY_HTTP_CONNECT_TIMEOUT_MS=3000
GATEWAY_HTTP_RESPONSE_TIMEOUT_MS=32000
MOCK_BAILIAN_NORMAL_LATENCY_MS=100
MOCK_BAILIAN_EXTREME_LATENCY_MS=3800
# Mock 的默认 7s 是慢响应场景，不再代表 30s 同步外层超时。
# 若要验证 provider 级超时 + 切换本地模型，把它设在 MODEL_L3_BAILIAN_TIMEOUT_MS(18s) 之上，例如 19000。
MOCK_BAILIAN_TIMEOUT_LATENCY_MS=7000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
TRACING_SAMPLING_PROBABILITY=1.0
